{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["ES2020", "DOM"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": false,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/__tests__/**", "node_modules", "dist", "dist_packager", "coverage"]
}
