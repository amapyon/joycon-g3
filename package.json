{
  "name": "joycon-multi-cursor-final",
  "version": "1.1.0",
  "description": "Select display, control cursors with Joy-Cons (Gyro, Button Toggles/Resets), PowerPoint control via COM",
  "main": "dist/main/main.js",
  "scripts": {
    "copy-renderer": "mkdir -p dist/renderer/styles && cp src/renderer/*.html dist/renderer/ && cp src/renderer/styles/*.css dist/renderer/styles/",
    "build": "tsc && npm run copy-renderer",
    "watch": "npm run copy-renderer && tsc -w",
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "rebuild": "electron-rebuild -f -w node-hid,winax",
    "package-win": "electron-packager . \"JoyCon Clicker\" --platform=win32 --arch=x64 --out=dist_packager --overwrite --icon=assets/icon.ico --ignore=\"^/dist_.*\" --ignore=\"^/node_modules/(electron|electron-packager|electron-rebuild|\\.bin)(/|$)\" --ignore=\"^/\\.git$\" --ignore=\"^/\\.vscode$\" --ignore=\"^/assets$\""
  },
  "keywords": [
    "electron",
    "joycon",
    "node-hid",
    "gyro",
    "multi-display",
    "winax",
    "powerpoint",
    "com"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "35.1.5",
    "electron-packager": "^17.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.3",
    "@types/jest": "^29.5.14"
  },
  "dependencies": {
    "@openai/codex": "^0.77.0",
    "audit": "^0.0.6",
    "node-hid": "^3.1.2",
    "winax": "^3.6.2"
  }
}
