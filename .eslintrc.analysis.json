{
    "extends": "./.eslintrc.json",
    "rules": {
        "complexity": [
            "warn",
            10
        ],
        "max-depth": [
            "warn",
            4
        ],
        "max-lines": [
            "warn",
            {
                "max": 300,
                "skipBlankLines": true,
                "skipComments": true
            }
        ],
        "max-lines-per-function": [
            "warn",
            {
                "max": 80,
                "skipBlankLines": true,
                "skipComments": true
            }
        ],
        "max-params": [
            "warn",
            4
        ],
        "no-console": "warn"
    },
    "overrides": [
        {
            "files": ["src/__tests__/**/*.ts"],
            "rules": {
                "max-lines-per-function": "off"
            }
        },
        {
            "files": ["src/main/powerpoint-control.ts"],
            "rules": {
                "complexity": ["warn", 25],
                "max-depth": ["warn", 6]
            }
        },
        {
            "files": ["src/renderer/cursor-renderer.ts"],
            "rules": {
                "complexity": ["warn", 20],
                "max-lines": ["warn", { "max": 350, "skipBlankLines": true, "skipComments": true }]
            }
        },
        {
            "files": ["src/renderer/timer-renderer.ts"],
            "rules": {
                "max-lines": ["warn", { "max": 420, "skipBlankLines": true, "skipComments": true }]
            }
        }
    ]
}
